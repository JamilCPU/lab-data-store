# Settings read by ingest-api (and store-admin). Copy to .env and fill in. Never commit .env.
# In the cluster these come from the Secret lab-data-store and the Deployment env (see docs/deploy.md).
# Optional. When set, the API bootstraps (migrations, roles, grants) itself on start and
# `store-admin token ...` uses it. In the cluster only the bootstrap initContainer has it.
STORE_ADMIN_DSN=postgresql://postgres:change-me@localhost:5432/lab
STORE_INGEST_DSN=postgresql://ingest:change-me@localhost:5432/lab
SOURCES_FILE=ingest-api/config/sources.example.yaml
RATE_LIMIT_PER_MINUTE=120
MAX_BATCH=5000
PORT=8080

# Role passwords, one pair per source in the sources file.
INGEST_PASSWORD=change-me
USAGE_OWNER_PASSWORD=change-me
USAGE_READER_PASSWORD=change-me
BANK_OWNER_PASSWORD=change-me
BANK_READER_PASSWORD=change-me
EMAIL_OWNER_PASSWORD=change-me
EMAIL_READER_PASSWORD=change-me
SMS_OWNER_PASSWORD=change-me
SMS_READER_PASSWORD=change-me
